*.pyc
.pytest_cache/

# Node / frontend
web/node_modules/
web/dist/

# OS
.DS_Store
Thumbs.db

# ---- Public-repo hygiene (added when publishing) ----
# Raw / third-party / large data pulls: regenerable, and not ours to republish (BBRef, Torvik, ESPN, Hashtag...)
ingest/research/data/*
# ...except small production artifacts worth keeping in version control:
!ingest/research/data/kalman_fit_[A-Z0-9]*.json
ingest/research/data/kalman_fit_*_*.json
!ingest/research/data/breakout_validation.json
!ingest/research/data/rookie_breakout_validation.json
!ingest/research/data/breakout_ledger/
!ingest/research/data/aging_shape*.json
!ingest/research/data/prospect_calibration.json
# scratch / caches / models
*.pkl
*.parquet
*.log
__pycache__/
.venv/
# local-only source for build script; big and not displayed
dashboard/rookie_scores.json
.claude/

# noisy run logs
*_log.txt
*.log
ingest/live_out/
dashboard/live_matchup.json
ingest/research/data/form/
