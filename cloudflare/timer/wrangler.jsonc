// Delegation timer: a Cloudflare Worker that starts the hub's GitHub workflows on time (see index.js).
// Deploy from this folder:  npx wrangler deploy        Token (once):  npx wrangler secret put GH_TOKEN
{
  "name": "delegation-timer",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
